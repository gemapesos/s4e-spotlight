{
  "manifest_version": 3,
  "name": "Command Palette",
  "description": "Open a focused command palette with Command+/ or Ctrl+/.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "debugger"],
  "host_permissions": ["https://sellercentral.amazon.com/*"],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["geist-latin-wght-normal.woff2", "geist-mono-latin-wght-normal.woff2", "palette-app.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["paste-guard.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://sellercentral.amazon.com/*"],
      "js": ["seller-central.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://sellercentral.amazon.com/*"],
      "js": ["passkey-guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://sellercentral.amazon.com/*"],
      "js": ["account-automation.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
